#!/bin/zsh
# MockMan launcher — starts the server (if not already running) and opens the UI.
# The app idles at the dashboard; an interview session begins only when you
# join a meeting from the UI.
#
# Optional: to get a double-clickable app, open Automator -> Application ->
# "Run Shell Script" -> paste the absolute path to this script -> save as
# MockMan.app.

cd "$(dirname "$0")"
PORT="${MOCKMAN_PORT:-8420}"

if ! curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
  echo "starting MockMan server on :$PORT …"
  .venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port "$PORT" \
    > /tmp/mockman-server.log 2>&1 &
  for _ in {1..30}; do
    curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1 && break
    sleep 1
  done
fi

open "http://127.0.0.1:$PORT"
