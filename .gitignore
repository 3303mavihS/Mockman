# --- runtime (recreate per machine; never commit) ---
.python/
.venv/

# --- compiled Swift binaries (rebuild: swiftc -O <name>.swift -o <name>) ---
/record
/transcribe

# --- user interview data (private; never commit) ---
sessions/
profile/

# --- scratch & media ---
*.wav
*.m4a
*.aiff
*.log
__pycache__/
.DS_Store

# --- opencode runtime deps (auto-installed) ---
.opencode/node_modules/

# --- web UI build artifacts ---
webui/node_modules/
webui/dist/

# --- local secrets ---
.env
*.local
.python/


# --- runtime state ---
.mockman.pid

# --- launcher app bundle (regenerate per machine) ---
MockMan.app/
